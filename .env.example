# ==============================================================================
# SafeTransit-AI: Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      copy .env.example .env
# 2. Fill in your actual credentials and settings in '.env'.
# 3. NEVER commit your '.env' file containing secrets to version control.
# ==============================================================================

# Flask Core Application Settings
SECRET_KEY=replace_with_a_secure_random_hex_string_in_production
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000

# Telegram SOS Alerting Service
# Note: Generate a Bot Token from Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_placeholder
# Note: Chat ID can be obtained via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_placeholder

# Detection & Alert Throttling
CONFIDENCE_THRESHOLD=0.35
ALERT_COOLDOWN_SECONDS=60

# Model Paths & Labels
YOLO_MODEL_PATH=best.pt
SEVERITY_MODEL_PATH=severity_model.pkl
CLASS_NAMES_PATH=coco1.txt

# Inference Backend Runtime ('opencv_dnn' for native Windows without DLL issues, or 'torch' in WSL2/Linux)
INFERENCE_BACKEND=opencv_dnn
